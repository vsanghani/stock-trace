# Clerk publishable key (pk_test_ or pk_live_). Safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key (sk_test_ or sk_live_). Server-only; never expose it to the client.
CLERK_SECRET_KEY=

# Postgres connection string for the app database.
DATABASE_URL=

# User-Agent for SEC EDGAR requests, including a contact email.
SEC_USER_AGENT=

# OpenRouter API key for news-sentiment scoring and forecast assumptions.
OPENROUTER_API_KEY=

# Alpha Vantage API key for news headlines used by sentiment analysis.
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep API key for supplementary DCF fundamentals.
FMP_API_KEY=

# Public site origin for canonical URLs, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Clerk route for the sign-in page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Clerk route for the sign-up page.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where Clerk sends a user after sign-in when no redirect_url is present.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# Where Clerk sends a user after sign-up when no redirect_url is present.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Sentry DSN for server and edge errors. Leave empty to disable Sentry.
SENTRY_DSN=

# Sentry DSN for browser errors. Public. Leave empty to disable client reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token used only at build time to upload source maps. Leave empty to skip the upload.
SENTRY_AUTH_TOKEN=

# Sentry organization slug. Required, with SENTRY_PROJECT, before source maps are uploaded.
SENTRY_ORG=

# Sentry project slug. Required, with SENTRY_ORG, before source maps are uploaded.
SENTRY_PROJECT=

# Upstash Redis REST URL for shared rate limits. Leave empty to use the in-memory window.
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token. Both this and the URL are required before Redis is used.
UPSTASH_REDIS_REST_TOKEN=
