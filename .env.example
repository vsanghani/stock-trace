# Clerk publishable key (pk_test_ or pk_live_). Safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key (sk_test_ or sk_live_). Server-only; never expose it to the client.
CLERK_SECRET_KEY=

# Postgres connection string for the app database.
DATABASE_URL=

# User-Agent for SEC EDGAR requests, including a contact email.
SEC_USER_AGENT=

# OpenRouter API key for news-sentiment scoring and forecast assumptions.
OPENROUTER_API_KEY=

# Alpha Vantage API key for news headlines used by sentiment analysis.
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep API key for supplementary DCF fundamentals.
FMP_API_KEY=

# Public site origin for canonical URLs, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Clerk route for the sign-in page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Clerk route for the sign-up page.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where Clerk sends a user after sign-in when no redirect_url is present.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# Where Clerk sends a user after sign-up when no redirect_url is present.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
